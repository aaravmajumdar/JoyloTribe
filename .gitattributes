# Normalize all text files to LF in the repo, checkout as-is on all platforms
* text=auto eol=lf

# Explicitly force LF for web source files
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
*.json text eol=lf
*.xml  text eol=lf
*.txt  text eol=lf
*.md   text eol=lf
*.mjs  text eol=lf

# Binary files — never touch line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.svg  binary
*.ttf  binary
*.woff binary
*.woff2 binary
*.eot  binary
*.pdf  binary
*.zip  binary
